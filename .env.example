# ── SAGARDRISHTI environment template ─────────────────────────────
# Copy to `.env` and fill in real values. Never commit `.env`.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env

# ── Application ──
APP_NAME=SAGARDRISHTI
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── CORS (comma-separated origins allowed to call the API) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL + PostGIS ──
# The API connects via DATABASE_URL. Compose builds it from the parts below.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sagardrishti
POSTGRES_USER=sagardrishti
POSTGRES_PASSWORD=changeme_in_dotenv
DATABASE_URL=postgresql+psycopg2://sagardrishti:changeme_in_dotenv@db:5432/sagardrishti
# For local runs WITHOUT docker (backend on host, db in docker):
# DATABASE_URL=postgresql+psycopg2://sagardrishti:changeme_in_dotenv@localhost:5432/sagardrishti

# ── Application authentication (stateless JWT) ──
# Generate with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-dotenv
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_PASSWORD_MIN_LENGTH=10

# ── AIS providers (backend-only; never exposed to the frontend) ──
# AISStream requires a key. Open Waters works anonymously; set the free
# personal API token here for higher limits (sent as Bearer when present,
# anonymous otherwise — data semantics unchanged either way).
AISSTREAM_API_KEY=
OPENWATERS_API_KEY=
# VesselAPI - third independent AIS source
# Backend only. Never expose through VITE_*
VESSELAPI_API_KEY=
# Optional VesselAPI tuning: one regional box per cycle, round-robin.
# Default cycle is 6h (~4 quota/day). Lower sparingly — monthly quota is small.
# VESSELAPI_POLL_INTERVAL_S=21600

# ── Frontend (Vite only reads vars prefixed with VITE_) ──
VITE_API_BASE_URL=http://localhost:8000
